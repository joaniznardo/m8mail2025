; Zona DNS per a demoasixcloud2025.cat (resolució interna del laboratori)
; SOA serial: YYYYMMDDNN
$ORIGIN demoasixcloud2025.cat.
$TTL 300

@   IN  SOA ns1.demoasixcloud2025.cat. admin.demoasixcloud2025.cat. (
        2025031101  ; Serial
        3600        ; Refresh
        600         ; Retry
        86400       ; Expire
        300         ; Minimum TTL
    )

; --- Servidors de noms ---
@                   IN  NS      ns1.demoasixcloud2025.cat.
ns1                 IN  A       10.26.50.2

; --- Infraestructura ---
router              IN  A       10.26.50.1
dns                 IN  A       10.26.50.2
proxy               IN  A       10.26.50.3

; --- Servidor de correu: alumnat (docker-mailserver) ---
mail.alumnat        IN  A       10.26.50.10
alumnat             IN  MX  10  mail.alumnat.demoasixcloud2025.cat.
alumnat             IN  A       10.26.50.10

; --- Servidor de correu: professorat (Stalwart) ---
mail.professorat    IN  A       10.26.50.20
professorat         IN  MX  10  mail.professorat.demoasixcloud2025.cat.
professorat         IN  A       10.26.50.20

; --- Servidor de correu: alumni (Mailcow) ---
mail.alumni         IN  A       10.26.50.30
alumni              IN  MX  10  mail.alumni.demoasixcloud2025.cat.
alumni              IN  A       10.26.50.30

; --- Clients ---
thunderbird1        IN  A       10.26.50.100
thunderbird2        IN  A       10.26.50.101
roundcube           IN  A       10.26.50.102
client-swaks        IN  A       10.26.50.200
acme                IN  A       10.26.50.250

; --- Autodiscover / Autoconfig per clients de correu ---
autoconfig.alumnat      IN  CNAME   mail.alumnat
autodiscover.alumnat    IN  CNAME   mail.alumnat
autoconfig.professorat  IN  CNAME   mail.professorat
autodiscover.professorat IN CNAME   mail.professorat
autoconfig.alumni       IN  CNAME   mail.alumni
autodiscover.alumni     IN  CNAME   mail.alumni
