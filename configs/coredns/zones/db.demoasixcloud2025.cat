; Zona DNS per a demoasixcloud2025.cat (resolució interna del laboratori)
; SOA serial: YYYYMMDDNN
$ORIGIN demoasixcloud2025.cat.
$TTL 300

@   IN  SOA ns1.demoasixcloud2025.cat. admin.demoasixcloud2025.cat. (
        2026041606  ; Serial
        3600        ; Refresh
        600         ; Retry
        86400       ; Expire
        300         ; Minimum TTL
    )

; --- Servidors de noms ---
@                   IN  NS      ns1.demoasixcloud2025.cat.
ns1                 IN  A       10.26.50.2

; --- Infraestructura ---
router              IN  A       10.26.50.1
dns                 IN  A       10.26.50.2
proxy               IN  A       10.26.50.3

; --- Servidor de correu: alumnat (docker-mailserver) ---
mail.alumnat        IN  A       10.26.50.10
alumnat             IN  MX  10  mail.alumnat.demoasixcloud2025.cat.
alumnat             IN  A       10.26.50.10

; --- Servidor de correu: professorat (Stalwart) ---
mail.professorat    IN  A       10.26.50.20
professorat         IN  MX  10  mail.professorat.demoasixcloud2025.cat.
professorat         IN  A       10.26.50.20

; --- Servidor de correu: alumni (Mailcow) ---
mail.alumni         IN  A       10.26.50.30
alumni              IN  MX  10  mail.alumni.demoasixcloud2025.cat.
alumni              IN  A       10.26.50.30

; --- Clients ---
thunderbird1        IN  A       10.26.50.100
thunderbird2        IN  A       10.26.50.101
roundcube           IN  A       10.26.50.102
client-swaks        IN  A       10.26.50.200
acme                IN  A       10.26.50.250

; --- Autodiscover / Autoconfig per clients de correu ---
; Apunten al proxy (10.26.50.3) que serveix els XML d'autoconfig
autoconfig.alumnat      IN  A       10.26.50.3
autodiscover.alumnat    IN  A       10.26.50.3
autoconfig.professorat  IN  A       10.26.50.3
autodiscover.professorat IN A       10.26.50.3
autoconfig.alumni       IN  A       10.26.50.3
autodiscover.alumni     IN  A       10.26.50.3

; --- Registres SPF, DKIM i DMARC per a alumnat ---
alumnat                       IN  TXT     "v=spf1 ip4:10.26.50.0/24 mx ~all"
mail._domainkey.alumnat IN  TXT     ( "v=DKIM1; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAhZOaEeWGqITMs0QEsGT3IyXui+0vVjjJOpJYKY0adt6FmXG5nnZSl3+TmBJ8LIa2Rv2mObmo7pPAVSvddBgD3mbtf2FdspU+OPtX0PoP7yPs527RWGMGAE2fzeBzlRuX/LbSaym18dE0cq/gGpGN2oPazb5w8NYPE7Q7M31929EG+UF6JhIMd3Doce6FBaEy5" "JxEoz2JZHorH6FTLswRWOYl6ZuJGD+awa3VHSVkBNuNbn9njKXuFNCiFVsfN8ONVI+Y0HiwNo/FTqyDjF/o5NvqcqCypKJf5VAICjWL4N8sR8p7bS0aaeD7fIbF1yxR2802VKiyje7ay2UsZZTTaQIDAQAB" )
_dmarc.alumnat                IN  TXT     "v=DMARC1; p=none; rua=mailto:postmaster@alumnat.demoasixcloud2025.cat"

