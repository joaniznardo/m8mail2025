# Cloudflare API Token per a la validació DNS de Let's Encrypt
# Necessites un token amb permisos: Zone:DNS:Edit per a la zona demoasixcloud2025.cat
# Crea'l a: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=el_teu_token_aqui

# Cloudflare Zone ID per a demoasixcloud2025.cat
# El trobaràs a la pàgina principal de la zona a Cloudflare (columna dreta)
CF_ZONE_ID=el_teu_zone_id_aqui

# Dominis del laboratori (normalment no cal canviar)
DOMAIN_ALUMNAT=alumnat.demoasixcloud2025.cat
DOMAIN_PROFESSORAT=professorat.demoasixcloud2025.cat
DOMAIN_ALUMNI=alumni.demoasixcloud2025.cat
